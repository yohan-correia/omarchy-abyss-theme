    "editor.findMatchBorder": "#C2A46D",
    "editor.findMatchHighlightBackground": "#25445B80",
    "editor.wordHighlightBackground": "#25445B80",
    "editor.wordHighlightStrongBackground": "#25445B80",
    "textLink.foreground": "#78A6CC",
    "textLink.activeForeground": "#78A6CC",
    "textCodeBlock.background": "#101C26",
    "textBlockQuote.background": "#101C26",
    "textBlockQuote.border": "#C2A46D",
    "scrollbarSlider.background": "#25364380",
    "scrollbarSlider.hoverBackground": "#45617899",
    "scrollbarSlider.activeBackground": "#45617899",
    "errorForeground": "#D7837D",
    "editorError.foreground": "#D7837D",
    "terminal.ansiRed": "#D7837D",
    "gitDecoration.deletedResourceForeground": "#D7837D",
    "editorWarning.foreground": "#C2A46D",
    "editorInfo.foreground": "#78A6CC",
    "gitDecoration.modifiedResourceForeground": "#78A6CC",
    "gitDecoration.addedResourceForeground": "#91B79E",
    "diffEditor.insertedLineBackground": "#102B20",
    "diffEditor.removedLineBackground": "#341B20",
    "statusBar.debuggingBackground": "#25445B",
    "statusBarItem.remoteBackground": "#25445B",
    "statusBar.debuggingForeground": "#D8DFE5",
    "statusBarItem.remoteForeground": "#D8DFE5",
    "terminal.ansiBlack": "#06090b",
    "terminal.ansiGreen": "#91B79E",
    "terminal.ansiYellow": "#C2A46D",
    "terminal.ansiBlue": "#78A6CC",
    "terminal.ansiMagenta": "#B4A0C7",
    "terminal.ansiCyan": "#83BCC5",
    "terminal.ansiWhite": "#D8DFE5",
    "terminal.ansiBrightBlack": "#718593",
    "terminal.ansiBrightRed": "#EDA09A",
    "terminal.ansiBrightGreen": "#AED0B8",
    "terminal.ansiBrightYellow": "#E3C58D",
    "terminal.ansiBrightBlue": "#9CC9EC",
    "terminal.ansiBrightMagenta": "#D0BDE2",
    "terminal.ansiBrightCyan": "#A4D8DE",
    "terminal.ansiBrightWhite": "#F0EADF"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8296A5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#91B79E"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#D5A078"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D0BDE2"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#9CC9EC"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#78A6CC"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#C2A46D"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#D8DFE5"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#83BCC5"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#83BCC5"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#78A6CC"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#8296A5"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#C2A46D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#D8DFE5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#D8DFE5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#91B79E"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#78A6CC"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#91B79E"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#D7837D"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#C2A46D"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#D8DFE5",
    "parameter": "#83BCC5",
    "property": "#83BCC5",
    "function": "#78A6CC",
    "method": "#78A6CC",
    "class": "#C2A46D",
    "interface": "#C2A46D",
    "enum": "#C2A46D",
    "type": "#C2A46D",
    "typeParameter": "#C2A46D",
    "namespace": "#78A6CC",
    "decorator": "#83BCC5",
    "enumMember": "#D5A078",
    "variable.readonly": "#E3C58D",
    "string": "#91B79E",
    "number": "#D5A078",
    "keyword": "#D0BDE2",
    "operator": "#9CC9EC",
    "comment": {
      "foreground": "#8296A5",
      "italic": true
    }
  }
}
