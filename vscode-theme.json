    "notifications.border": "#253643",
    "titleBar.border": "#253643",
    "statusBar.border": "#253643",
    "tab.border": "#253643",
    "editorIndentGuide.background1": "#253643",
    "editorRuler.foreground": "#253643",
    "focusBorder": "#C2A46D",
    "tab.activeBorderTop": "#C2A46D",
    "tab.unfocusedActiveBorderTop": "#C2A46D",
    "tab.activeModifiedBorder": "#C2A46D",
    "panelTitle.activeBorder": "#C2A46D",
    "activityBar.activeBorder": "#C2A46D",
    "activityBar.foreground": "#C2A46D",
    "editorCursor.foreground": "#C2A46D",
    "terminalCursor.foreground": "#C2A46D",
    "editorLineNumber.activeForeground": "#C2A46D",
    "progressBar.background": "#C2A46D",
    "button.background": "#C2A46D",
    "badge.background": "#C2A46D",
    "activityBarBadge.background": "#C2A46D",
    "list.highlightForeground": "#C2A46D",
    "button.foreground": "#06090B",
    "badge.foreground": "#06090B",
    "activityBarBadge.foreground": "#06090B",
    "terminalCursor.background": "#06090B",
    "button.hoverBackground": "#D8BB82",
    "editor.selectionBackground": "#25445B",
    "terminal.selectionBackground": "#25445B",
    "list.activeSelectionBackground": "#25445B",
    "list.inactiveSelectionBackground": "#25445B",
    "editorSuggestWidget.selectedBackground": "#25445B",
    "quickInputList.focusBackground": "#25445B",
    "list.activeSelectionForeground": "#D8DFE5",
    "list.inactiveSelectionForeground": "#D8DFE5",
    "quickInputList.focusForeground": "#D8DFE5",
    "editorSuggestWidget.selectedForeground": "#D8DFE5",
    "list.hoverBackground": "#172A39",
    "toolbar.hoverBackground": "#172A39",
    "tab.hoverBackground": "#172A39",
    "button.secondaryHoverBackground": "#172A39",
    "list.focusOutline": "#C2A46D80",
